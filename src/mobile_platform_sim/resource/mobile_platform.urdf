<!--
URDF description for the mecanum-wheeled mobile platform (mobile_platform_sim).

This file serves two purposes:
    1. Provides the full link/joint tree for robot_state_publisher to build the TF tree. Links include
the base, four wheels and two Livox MID-70 Lidar frames.
    2. Declares Webots plugin and device bindings via the webots block, parsed by webots_ros2_driver at
runtime.

Webots plugins:
    MecanumRobotDriver — custom mecanum kinematics controller
(mobile_platform_sim/mecanum_robot_driver.py)

Webots devices:
    lidar — Livox MID-70 front lidar -> /livox/lidar_front
    lidar2 — Livox MID-70 back lidar -> /livox/lidar_back

TF tree:
    base_link
    ├── wheel_fl  (motor_fl,  continuous)
    ├── wheel_fr  (motor_fr,  continuous)
    ├── wheel_bl  (motor_bl,  continuous)
    ├── wheel_br  (motor_br,  continuous)
    ├── livox_frame  (livox_joint1, fixed) — front lidar
    └── livox_frame2 (livox_joint2, fixed) — back  lidar
-->
<robot name="mobile_platform_sim">
    <!-- PLATFORM GEOMETRY    -->
    <!-- Base chassis — visual and collision from CAD mesh -->
    <link name="base_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://mobile_platform_sim/meshes/chassis.stl" />
            </geometry>
            <material name="white">
                <color rgba="1.0 1.0 1.0 1.0" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://mobile_platform_sim/meshes/chassis.stl" />
            </geometry>
        </collision>
    </link>
    <!-- Front-left wheel -->
    <link name="wheel_fl">
        <visual>
            <origin rpy="1.5708 0 0" xyz="0 0 0" />
            <geometry>
                <cylinder length="0.077" radius="0.1015" />
            </geometry>
        </visual>
        <collision>
            <origin rpy="1.5708 0 0" xyz="0 0 0" />
            <geometry>
                <cylinder length="0.077" radius="0.1015" />
            </geometry>
        </collision>
    </link>
    <!-- Front-right wheel -->
    <link name="wheel_fr">
        <visual>
            <origin rpy="1.5708 0 0" xyz="0 0 0" />
            <geometry>
                <cylinder length="0.077" radius="0.1015" />
            </geometry>
        </visual>
        <collision>
            <origin rpy="1.5708 0 0" xyz="0 0 0" />
            <geometry>
                <cylinder length="0.077" radius="0.1015" />
            </geometry>
        </collision>
    </link>
    <!-- Back-left wheel -->
    <link name="wheel_bl">
        <visual>
            <origin rpy="1.5708 0 0" xyz="0 0 0" />
            <geometry>
                <cylinder length="0.077" radius="0.1015" />
            </geometry>
        </visual>
        <collision>
            <origin rpy="1.5708 0 0" xyz="0 0 0" />
            <geometry>
                <cylinder length="0.077" radius="0.1015" />
            </geometry>
        </collision>
    </link>
    <!-- Back-right wheel -->
    <link name="wheel_br">
        <visual>
            <origin rpy="1.5708 0 0" xyz="0 0 0" />
            <geometry>
                <cylinder length="0.077" radius="0.1015" />
            </geometry>
        </visual>
        <collision>
            <origin rpy="1.5708 0 0" xyz="0 0 0" />
            <geometry>
                <cylinder length="0.077" radius="0.1015" />
            </geometry>
        </collision>
    </link>
    <!-- Livox MID-70 front lidar frame -->
    <link name="livox_frame">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://mobile_platform_sim/meshes/livox_mount.stl" />
            </geometry>
            <material name="white">
                <color rgba="1.0 1.0 1.0 1.0" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://mobile_platform_sim/meshes/livox_mount.stl" />
            </geometry>
        </collision>
    </link>
    <!-- Livox MID-70 back lidar frame -->
    <link name="livox_frame2">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://mobile_platform_sim/meshes/livox_mount.stl" />
            </geometry>
            <material name="white">
                <color rgba="1.0 1.0 1.0 1.0" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://mobile_platform_sim/meshes/livox_mount.stl" />
            </geometry>
        </collision>
    </link>
    <!-- JOINTS -->
    <!-- Front-left wheel: L_X=0.2505, L_Y=0.26536 -->
    <joint name="motor_fl" type="continuous">
        <origin rpy="0 0 0" xyz="0.2505 0.26536 0" />
        <parent link="base_link" />
        <child link="wheel_fl" />
        <axis xyz="0 1 0" />
        <limit effort="100" velocity="100" />
    </joint>
    <!-- Front-right wheel -->
    <joint name="motor_fr" type="continuous">
        <origin rpy="0 0 0" xyz="0.2505 -0.26536 0" />
        <parent link="base_link" />
        <child link="wheel_fr" />
        <axis xyz="0 1 0" />
        <limit effort="100" velocity="100" />
    </joint>
    <!-- Back-left wheel -->
    <joint name="motor_bl" type="continuous">
        <origin rpy="0 0 0" xyz="-0.2505 0.26536 0" />
        <parent link="base_link" />
        <child link="wheel_bl" />
        <axis xyz="0 1 0" />
        <limit effort="100" velocity="100" />
    </joint>
    <!-- Back-right wheel -->
    <joint name="motor_br" type="continuous">
        <origin rpy="0 0 0" xyz="-0.2505 -0.26536 0" />
        <parent link="base_link" />
        <child link="wheel_br" />
        <axis xyz="0 1 0" />
        <limit effort="100" velocity="100" />
    </joint>
    <!-- Front lidar: 0.4583 m ahead, 0.0927 m above base -->
    <joint name="livox_joint1" type="fixed">
        <origin rpy="0 0 0" xyz="0.4583 0 0.0927" />
        <parent link="base_link" />
        <child link="livox_frame" />
    </joint>
    <!-- Back lidar: rotated 180 deg around Z -->
    <joint name="livox_joint2" type="fixed">
        <origin rpy="0 0 3.14159" xyz="-0.4583 0 0.0927" />
        <parent link="base_link" />
        <child link="livox_frame2" />
    </joint>
    <!-- WEBOTS / ROS2 PLUGINS -->
    <webots>
        <!--Custom mecanum kinematics controller (mobile_platform_sim/mecanum_robot_driver.py) -->
        <plugin type="mobile_platform_sim.mecanum_robot_driver.MecanumRobotDriver" />
        <!-- Livox MID-70 front lidar -->
        <device reference="lidar" type="Lidar">
            <ros>
                <enabled>true</enabled>
                <updateRate>10</updateRate>
                <topicName>/livox/lidar_front</topicName>
                <frameName>livox_frame</frameName>
            </ros>
        </device>
        <!-- Livox MID-70 back lidar -->
        <device reference="lidar2" type="Lidar">
            <ros>
                <enabled>true</enabled>
                <updateRate>10</updateRate>
                <topicName>/livox/lidar_back</topicName>
                <frameName>livox_frame2</frameName>
            </ros>
        </device>
    </webots>
</robot>